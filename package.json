{
  "name": "mpdgi-stats",
  "version": "1.4.10",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:stats": "node tests/stats-unit.mjs",
    "validate:auth": "node tests/stats-auth-integration.mjs",
    "benchmark:kdf": "node tests/kdf-benchmark.mjs",
